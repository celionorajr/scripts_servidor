# Copie este conteúdo para /root/.env no servidor Socorrão.
# Não versionar /root/.env: ele contém a senha SMTP.

# === Identificação da unidade ===
UNIDADE="Socorrão I"

# === Armazenamentos ===
HD_PRINCIPAL=/mnt/storage3
HD_BACKUP=/mnt/ExamesAntigos2

# === E-mail ===
EMAIL_REMETENTE=suporte@polos.tec.br
EMAIL_SENHA=SUBSTITUA_PELA_SENHA_SMTP
EMAIL_SMTP_HOST=smtp.hostinger.com
EMAIL_SMTP_PORT=587
EMAIL_DESTINATARIOS=suporte@polos.tec.br
EMAIL_DESTINATARIOS_2=suporte@polos.tec.br

# === Limites de armazenamento ===
LIMITE_USO_HD_PRINCIPAL=80
LIMITE_USO_HD_BACKUP=80

# === Controle do monitoramento ===
CONTROLE_ARQUIVO=/root/ultimo_envio.txt
LOCK_FILE=/tmp/monitor_lock
TEMPO_MINIMO_ENVIO=300

# === Backup dos exames ===
BACKUP_LOG_DIR=/root/backup_logs
BACKUP_LOCK_FILE=/tmp/backup_pacs.lock
BACKUP_STATUS_FILE=/root/ultimo_backup_sucesso.json

# === Backup do banco PACS ===
PACSDB_NAME=pacsdb
PACSDB_LOCAL_DIR=/tmp
PACSDB_BACKUP_MOUNT=/mnt/ExamesAntigos2
PACSDB_BACKUP_SUBDIR=bkp_pacsdb
PACSDB_RETENTION_DAYS=7
